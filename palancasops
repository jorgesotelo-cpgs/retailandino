SELECT DISTINCT
    C.RETAILER,
    C.NAME,
    C.CAT3_NAME,
    C.SKU,
    A.RETAILER_PRODUCT_ID,
    A.STORE_ID,
    A.REASON,
    A.IN_STOCK,
    A.STATUS,
    A.ACTIVE,
    A.STARTS_AT,
    A.ends_at,
    DATE(A.CREATED_AT) AS FECHA
FROM PE_PG_MS_CPGS_CLG_OVERRIDE_DB_PUBLIC.OVERRIDE_AVAILABILITY A
JOIN PE_AMYSQL_CPGS_CLG_IM_CPGS_CLG_INVENTORY.PRODUCT P
  ON P.RETAILER_PRODUCT_ID = A.RETAILER_PRODUCT_ID
 AND P.STORE_ID = A.STORE_ID
JOIN RP_SILVER_DB_PROD.CPGS_LOCAL_ANALYTICS.TBL_RETAILER_PRODUCT_CP C
  ON C.PRODUCT_ID = A.RETAILER_PRODUCT_ID
 AND C.COUNTRY = 'PE'
JOIN RP_SILVER_DB_PROD.CPGS_LOCAL_ANALYTICS.TBL_DIM_STORES DM
  ON DM.CP_STORE_ID = A.STORE_ID
 AND DM.COUNTRY = 'PE'
WHERE A.REASON = '2_breaking_hour'
and A.CREATED_AT >= CURRENT_DATE -1;
