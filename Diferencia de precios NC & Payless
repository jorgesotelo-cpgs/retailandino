SELECT *
FROM (
  SELECT 
    o.store_id,
    o.name,
    o.vertical_sub_group,
    p.*,
    COUNT(d.order_id) AS total_POS,
    SUM(d.POS_AMOUNT) AS total_POS_amount,
    COUNT(CASE WHEN LOWER(d.mid_name) LIKE 'mfa%' THEN 1 END) AS Pago_MFA_mid,
    SUM(CASE WHEN LOWER(d.mid_name) LIKE 'MFA%' THEN d.POS_AMOUNT ELSE 0 END) AS Monto_MFA_mid,
    COUNT(CASE WHEN LOWER(d.mid_name) LIKE 'IKF%' THEN 1 END) AS Pago_IKF_mid,
    SUM(CASE WHEN LOWER(d.mid_name) LIKE 'IKF%' THEN d.POS_AMOUNT ELSE 0 END) AS Monto_IKF_mid,
    COUNT(CASE WHEN LOWER(d.mid_name) NOT LIKE 'mfa%' AND LOWER(d.mid_name) NOT LIKE 'ikf%' THEN 1 END) AS Pago_otros_pos,
